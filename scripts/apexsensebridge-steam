#!/usr/bin/env python3
"""Start a native bridge, wait for readiness, then run Steam's command unchanged."""
import argparse
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time


def options(argv):
    parser = argparse.ArgumentParser(
        description=__doc__,
        usage="%(prog)s [--startup-timeout SECONDS] [bridge options] -- %%command%%",
    )
    parser.add_argument("--bridge", help="path to ApexSenseBridge (normally found beside this launcher)")
    parser.add_argument("--startup-timeout", type=float, default=0,
                        help="controller wait limit; 0 waits until connected (default)")
    parser.add_argument("--log", help="bridge log path (default: XDG state directory)")
    if "--" not in argv:
        parser.parse_args(argv)  # Provide the usual --help response.
        parser.error("missing -- and the game command; in Steam use -- %command%")
    separator = argv.index("--")
    args, bridge_args = parser.parse_known_args(argv[:separator])
    if not math.isfinite(args.startup_timeout) or args.startup_timeout < 0:
        parser.error("--startup-timeout must be a finite number of seconds >= 0")
    if not argv[separator + 1:] or not argv[separator + 1]:
        parser.error("missing game command after --")
    for arg in bridge_args:
        if arg.split("=", 1)[0] in {"--telemetry-json", "--seconds", "--once", "--version", "--help", "-h"}:
            parser.error(f"{arg} cannot be used with this launcher")
    return args, bridge_args, argv[separator + 1:]


def bridge_path(explicit):
    if explicit:
        return explicit
    directory = Path(__file__).resolve().parent
    for candidate in (directory / "ApexSenseBridge", directory.parent / "bin/ApexSenseBridge",
                      directory.parent / "build-linux/ApexSenseBridge"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    found = shutil.which("ApexSenseBridge")
    if found:
        return found
    raise RuntimeError("ApexSenseBridge was not found; install it first or use --bridge PATH")


def stop_bridge(bridge):
    if bridge is None or bridge.poll() is not None:
        return
    bridge.terminate()
    try:
        bridge.wait(timeout=15)
    except subprocess.TimeoutExpired:
        print("Bridge cleanup timed out; reconnect the controller if effects remain active.", file=sys.stderr)
        bridge.kill()
        bridge.wait()


def main(argv):
    args, bridge_args, command = options(argv)
    executable = bridge_path(args.bridge)
    app_id = re.sub(r"[^a-zA-Z0-9_.-]", "_", os.environ.get("SteamAppId", "game"))[:80] or "game"
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    log_path = Path(args.log).expanduser() if args.log else state / "apexsensebridge" / f"steam-{app_id}.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    interrupted = 0

    def stopping(number, _frame):
        nonlocal interrupted
        interrupted = number

    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, stopping)
    bridge = game = temporary = None
    try:
        temporary = tempfile.TemporaryDirectory(prefix="apexsensebridge-steam-")
        with log_path.open("w") as log:
            status_path = Path(temporary.name) / "status.json"
            # Steam's runtime/overlay libraries are for the game. The native
            # bridge uses host libraries; the game retains its original env.
            bridge_env = os.environ.copy()
            for name in ("LD_LIBRARY_PATH", "LD_PRELOAD"):
                bridge_env.pop(name, None)
            bridge = subprocess.Popen([executable, "bridge", *bridge_args,
                                       "--telemetry-json", str(status_path)],
                                      env=bridge_env, stdout=log, stderr=subprocess.STDOUT)
            deadline = time.monotonic() + args.startup_timeout if args.startup_timeout else math.inf
            while not interrupted:
                if bridge.poll() is not None:
                    raise RuntimeError(f"Bridge exited before it was ready (status {bridge.returncode})")
                try:
                    if json.loads(status_path.read_text()).get("phase") == "running":
                        break
                except (OSError, ValueError):
                    pass
                if time.monotonic() >= deadline:
                    raise RuntimeError("Timed out waiting for a controller")
                time.sleep(0.05)
            if interrupted:
                return 128 + interrupted
            # No shell/eval: quoted paths and Steam/Proton argument boundaries
            # are preserved. A process group lets stop signals reach wrappers.
            game = subprocess.Popen(command, start_new_session=True)
            bridge_failure_reported = False
            while game.poll() is None and not interrupted:
                if bridge.poll() is not None and not bridge_failure_reported:
                    print(f"Bridge stopped; see {log_path}", file=sys.stderr)
                    bridge_failure_reported = True
                time.sleep(0.05)
            if interrupted:
                try:
                    os.killpg(game.pid, interrupted)
                    game.wait(timeout=10)
                except ProcessLookupError:
                    pass
                except subprocess.TimeoutExpired:
                    os.killpg(game.pid, signal.SIGKILL)
                    game.wait()
                return 128 + interrupted
            return game.returncode if game.returncode >= 0 else 128 - game.returncode
    except (OSError, RuntimeError) as error:
        print(f"ApexSenseBridge Steam launcher: {error}. See {log_path}", file=sys.stderr)
        return 1
    finally:
        stop_bridge(bridge)
        if temporary is not None:
            temporary.cleanup()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, RuntimeError) as error:
        print(f"ApexSenseBridge Steam launcher: {error}", file=sys.stderr)
        sys.exit(1)
