#!/usr/bin/env python3
"""Run Steam's game command immediately with a native bridge in the background."""
import argparse
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time


def options(argv):
    parser = argparse.ArgumentParser(
        description=__doc__,
        usage="%(prog)s [bridge options] -- %%command%%",
    )
    parser.add_argument("--bridge", help="path to ApexSenseBridge (normally found beside this launcher)")
    parser.add_argument("--log", metavar="FILE", help="save bridge output to FILE (disabled by default)")
    if "--" not in argv:
        parser.parse_args(argv)  # Provide the usual --help response.
        parser.error("missing -- and the game command; in Steam use -- %command%")
    separator = argv.index("--")
    args, bridge_args = parser.parse_known_args(argv[:separator])
    if not argv[separator + 1:] or not argv[separator + 1]:
        parser.error("missing game command after --")
    for arg in bridge_args:
        if arg.split("=", 1)[0] in {"--seconds", "--once", "--version", "--help", "-h"}:
            parser.error(f"{arg} cannot be used with this launcher")
    return args, bridge_args, argv[separator + 1:]


def bridge_path(explicit):
    if explicit:
        return explicit
    directory = Path(__file__).resolve().parent
    for candidate in (directory / "ApexSenseBridge", directory.parent / "bin/ApexSenseBridge",
                      directory.parent / "build-linux/ApexSenseBridge"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    found = shutil.which("ApexSenseBridge")
    if found:
        return found
    raise RuntimeError("ApexSenseBridge was not found; install it first or use --bridge PATH")


def stop_bridge(bridge):
    if bridge is None or bridge.poll() is not None:
        return
    bridge.terminate()
    try:
        bridge.wait(timeout=15)
    except subprocess.TimeoutExpired:
        print("Bridge cleanup timed out; reconnect the controller if effects remain active.", file=sys.stderr)
        bridge.kill()
        bridge.wait()


def main(argv):
    args, bridge_args, command = options(argv)
    log_path = Path(args.log).expanduser() if args.log else None
    log_hint = f" See {log_path}" if log_path else ""
    interrupted = 0

    def stopping(number, _frame):
        nonlocal interrupted
        interrupted = number

    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, stopping)
    bridge = game = None
    try:
        try:
            executable = bridge_path(args.bridge)
            if log_path:
                log_path.parent.mkdir(parents=True, exist_ok=True)
            with (log_path.open("w") if log_path else open(os.devnull, "w")) as log:
                # Steam's runtime/overlay libraries are for the game. The native
                # bridge uses host libraries; the game retains its original env.
                bridge_env = os.environ.copy()
                for name in ("LD_LIBRARY_PATH", "LD_PRELOAD"):
                    bridge_env.pop(name, None)
                bridge = subprocess.Popen([executable, "bridge", *bridge_args],
                                          env=bridge_env, stdout=log, stderr=subprocess.STDOUT)
        except (OSError, RuntimeError) as error:
            print(f"ApexSenseBridge could not start: {error}. Starting the game anyway.", file=sys.stderr)
        if interrupted:
            return 128 + interrupted
        # No shell/eval: quoted paths and Steam/Proton argument boundaries
        # are preserved. A process group lets stop signals reach wrappers.
        game = subprocess.Popen(command, start_new_session=True)
        bridge_failure_reported = False
        while game.poll() is None and not interrupted:
            if bridge is not None and bridge.poll() is not None and not bridge_failure_reported:
                print(f"Bridge stopped (status {bridge.returncode}); game continues.{log_hint}", file=sys.stderr)
                bridge_failure_reported = True
            time.sleep(0.05)
        if interrupted:
            try:
                os.killpg(game.pid, interrupted)
                game.wait(timeout=10)
            except ProcessLookupError:
                pass
            except subprocess.TimeoutExpired:
                os.killpg(game.pid, signal.SIGKILL)
                game.wait()
            return 128 + interrupted
        return game.returncode if game.returncode >= 0 else 128 - game.returncode
    except (OSError, RuntimeError) as error:
        print(f"ApexSenseBridge Steam launcher: {error}.{log_hint}", file=sys.stderr)
        return 1
    finally:
        stop_bridge(bridge)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, RuntimeError) as error:
        print(f"ApexSenseBridge Steam launcher: {error}", file=sys.stderr)
        sys.exit(1)
